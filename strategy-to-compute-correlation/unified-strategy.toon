spec_version: "4.4"
title: "Unified Strategy for Tax-Loss-Harvesting Replacements"
format: "TOON"

decision: "Use correlation only to generate replacement candidates. Make the trade decision by minimizing portfolio-level tracking error and trading cost subject to tax-lot, wash-sale, liquidity, factor-exposure, and concentration constraints."
key_principle: "For an S&P 500 universe, pairwise computation is cheap. Risk estimation, point-in-time data quality, tax-state tracking, transaction costs, and overfit control are the hard problems."

comparison:
  approaches[3|]{approach|best_contribution|main_weakness|unified_treatment}:
    "Correlation/factor candidate pipeline"|"Data hygiene, multi-horizon stability, factor awareness, walk-forward testing"|"Weighted pair scores remain ad hoc and pair-centric"|"Use for candidate generation and diagnostics"
    "Detailed tracking-error pair method"|"Direct TE ranking, EWMA/shrinkage, tail gates, position-size awareness, wash-sale ledger, strong baselines"|"A single peer remains an inefficient portfolio hedge; custom covariance code needs validation"|"Use as the first production-quality candidate layer"
    "Multi-tier daily/hourly/5-minute method"|"Execution friction, basket optimization, factor matching, ETF fallback, TCA"|"Cointegration and 5-minute lead-lag solve pairs-trading problems, not direct-indexing problems"|"Drop cointegration and lead-lag; retain basket optimization and intraday TCA"
  consensus: "Daily risk model -> approved candidate set -> portfolio optimizer -> tax/cost gate -> monitoring"

unified_production_strategy:
  objective:
    minimize_terms[5|]: "portfolio tracking error"|"expected spread and market impact"|"concentration and factor-drift penalties"|"unwind risk and cost"|"time-value-adjusted tax benefit"
    final_objective_exclusions[3|]: "raw correlation alone"|"cointegration"|"standalone pair score"

  data_layer:
    required_inputs[6|]: "split- and dividend-adjusted daily prices"|"point-in-time constituents, index weights, sectors, and sub-industries"|"stable issuer identifiers and corporate-action history"|"delisted securities where available"|"volume, ADV, bid-ask, and executable-price estimates"|"lot-level basis, holding period, account, purchase, and sale records"
    return_processing:
      return_definition: "close-to-close log returns"
      missing_data: "Use pairwise-complete observations with a minimum history; never apply global dropna across all securities."
      minimum_history_days: 250
      ranking_returns: "Robustly clipped returns may be used for ranking."
      tail_returns: "Keep raw returns for tail-risk and stress tests."

  risk_model:
    primary_frequency: "daily"
    history: "Use five years for context with greater weight on recent observations."
    covariance: "Exponentially weighted covariance with a starting half-life near 126 trading days."
    stabilization: "Use Ledoit-Wolf shrinkage or shrink correlations toward a sub-industry/group target."
    validate_out_of_sample: true
    estimated_features[5|]: "covariance and volatility"|"market, sector, and style-factor exposures"|"21- and 42-day return-difference tails"|"regime and stress sensitivity"|"overnight versus intraday divergence when adjusted open data is reliable"
    intraday_use[5|]: "liquidity"|"spread"|"volume profile"|"slippage"|"recent volatility and stress diagnostics"
    intraday_not_used_for[2|]: "cointegration selection"|"five-minute lead-lag selection"

  candidate_generation:
    exclusions[3|]: "same issuer, dual share class, ADR/ordinary pair, parent/subsidiary, merger-linked, or compliance-restricted relationships"|"active wash-sale blackouts and replacement-taint restrictions"|"insufficient history or liquidity"
    search_order[3|]: "same sub-industry"|"same industry"|"same sector"
    search_rule: "Treat the group hierarchy as a prior, not an absolute wall."
    ranking_metric: "Dollar-for-dollar tracking error from the shrunk covariance matrix."
    tracking_error_formula: "TE(A,B) = sqrt(var(A) + var(B) - 2 * cov(A,B))"
    correlation_prefilter: "Do not pre-filter on correlation; it is embedded in TE and can reject a lower-volatility, better-matched candidate."
    retained_candidates_per_stock: "5 to 10"
    post_ranking_gates[4|]: "unclipped tail-divergence"|"liquidity and transaction cost"|"factor-distance and exposure"|"rolling and regime stability"
    role_of_pair_table: "Explainable fallback and optimizer warm start, not the final trade rule."

  replacement_selection:
    position_rules[3|]{position_type|replacement_rule}:
      "small position"|"Use the best approved single peer only if incremental portfolio TE and tail risk are below limits."
      "material position"|"Use a constrained basket of 2 to 5 names."
      "concentrated or poorly covered position"|"Use a full portfolio optimizer; use a sector or index proxy only when separately approved by tax and compliance policy."
    optimizer:
      type: "long-only convex optimization"
      minimize[4|]: "active_weight' * covariance * active_weight"|"transaction cost"|"factor-drift penalty"|"concentration penalty"
      constraints[6|]: "proceeds invested within a cash tolerance"|"issuer and wash-sale exclusions"|"position limits"|"sector and factor limits"|"turnover and liquidity limits"|"portfolio tracking-error budget"
      simultaneous_harvests: "Evaluate all simultaneous harvests together; individually acceptable swaps can create unacceptable combined active exposure."

  tax_control_layer:
    independence_rule: "The statistical engine must not decide whether two securities are legally substantially identical."
    required_controls[3|]: "tax/compliance-approved relationship map"|"family-level ledger across relevant accounts"|"cross-account, DRIP, options, and automated-purchase monitoring"
    ledger_fields[6|]: "lot basis and holding period"|"purchases and loss sales within the applicable +/-30-day window"|"blackout dates"|"disallowed-loss basis adjustments"|"replacement purchases that block later replacement harvesting"|"specific-lot identification and trade settlement state"
    tax_policy: "Tax treatment is fact-specific. ETF bridges and same-issuer instruments require explicit approval, not a statistical assumption."

  harvest_decision:
    gate: "time-value-adjusted expected tax benefit > spread + market impact + fees + tracking-risk charge + expected unwind cost + operational safety margin"
    tax_model: "Treat tax-loss harvesting as tax deferral unless investor-specific assumptions justify another terminal treatment."
    lot_selection: "Rank lots by expected after-tax value, not raw loss percentage alone."
    post_blackout: "Do not automatically buy the original stock back. Re-optimize among keeping the replacement, returning to the original, or choosing a new allocation."

  validation:
    simulation_rule: "At every simulated trade date, use only information then available and point-in-time universe membership."
    benchmark_strategies[8|]: "no harvest"|"cash for the blackout period"|"broad-market proxy"|"sector or industry proxy"|"highest-correlation peer"|"lowest-TE shrunk peer"|"constrained 2 to 5-name basket"|"full portfolio optimizer"
    metrics[8|]: "net after-tax benefit after spread, impact, and basis-reset effects"|"portfolio-level predicted and realized TE"|"realized/predicted TE calibration over 21 and 42 trading days"|"95th and 99th percentile cumulative return divergence"|"coverage and rejection rate"|"turnover and liquidity usage"|"concentration and factor drift"|"wash-sale or ledger-control failures, target zero"
    method_hygiene[3|]: "Tune on one period and preserve a final untouched test period"|"Evaluate loss-triggered and stress events separately"|"Report both pair-level and accumulated portfolio-level results"

operating_cadence:
  weekly_or_event_driven[2|]: "Recompute daily covariance, factors, and candidate table weekly"|"Refresh after material corporate or market events"
  before_each_trade[2|]: "Update tax lots, blackouts, holdings, and eligibility"|"Recalculate optimizer and expected net value"
  execution: "Use intraday data for order sizing, spread and impact estimates, and scheduling."
  monitoring[3|]: "Monitor portfolio TE and active exposures daily"|"Invalidate candidates after corporate actions or relationship breakdowns"|"Maintain an audit trail of data, eligibility, optimizer, and execution decisions"

implementation_sequence[3|]{phase|scope}:
  "baseline"|"Exact S&P 500 TE table using adjusted daily returns, EWMA/shrinkage, legal exclusions, tail/liquidity gates, and walk-forward tests."
  "portfolio version"|"Basket and full optimizer with factor, turnover, concentration, and total TE constraints."
  "production controls"|"Complete tax ledger, cross-account and DRIP integration, transaction-cost model, audit trail, and post-trade monitoring."

success_definition: "Retain pair ranking for simplicity and auditability, but make live decisions portfolio-aware, tax-controlled, cost-aware, and validated by out-of-sample economic results."
tax_reference: "https://www.irs.gov/publications/p550"
