# first run on 20261113

	SP500="$(sed '1d' stock-extractor/input/sp500_tickers.txt | tr '\n' ' ')"
	JAR="target/stock-correlation.jar"
	OUT="/tmp/stock-correlation-results"

	mkdir -p "$OUT"

	while read -r window bars; do
	  java -jar "$JAR" \
	    --data-dir /Users/zhewu/data/stocks/20261109 \
	    --tickers "$SP500" \
	    --target ORCL \
	    --analysis-rows "$bars" \
	    --min-overlap 21 \
	    --top-k 503 \
	    > "$OUT/all_${window}.log"

	  for target in orcl aapl ebay goog; do
	    awk -v target="$target" '
	      $0 == "Candidates for " target ":" { found=1; next }
	      found && /^Candidates for / { exit }
	      found && /^  [a-z0-9-]+[[:space:]]+overlap=/ { print }
	    ' "$OUT/all_${window}.log" \
	      | sort -k4,4nr \
	      > "$OUT/${target}_${window}.txt"
	  done
	done <<'WINDOWS'
